    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\BuildingBlocks\EmergencyHub.BuildingBlocks.Domain\EmergencyHub.BuildingBlocks.Domain.csproj" />
  </ItemGroup>

</Project>
