<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Employee 서비스 통합 테스트(testing-strategy.md "통합 테스트 · 테스트 DB 구성 (fixture)", S03-T06 · S03-T07).
    OutputType=Exe · IsTestProject=true는 Directory.Build.props가 이름 규칙(*Tests)으로 지정한다(ADR-0021).
    xunit.runner.visualstudio · coverlet.collector의 PrivateAssets=all은 Directory.Build.targets가 적용한다.
    Testcontainers로 실제 PostgreSQL을 띄우고(InMemory · SQLite 금지), 운영 등록 코드(AddEmployeeInfrastructure)로 DbContext를 만든다.
    EmergencyHubUsesPostgresImage=true: 이미지 태그를 Directory.Build.props 한 곳에서 어셈블리 메타데이터로 받는다(코드에 태그 리터럴 금지, TD-004).
  -->
  <PropertyGroup>
    <EmergencyHubUsesPostgresImage>true</EmergencyHubUsesPostgresImage>
  </PropertyGroup>

  <!--
    Microsoft.AspNetCore.App: 운영과 같은 IConfiguration(ConfigurationBuilder · 메모리 설정)으로 AddEmployeeInfrastructure를 부르고,
    S03-T07 WebApplicationFactory<Program>도 같은 프레임워크를 쓴다(Microsoft.AspNetCore.Mvc.Testing 추가).
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Respawn" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <!--
    Api 참조: WebApplicationFactory<EmergencyHub.Employee.Api.Program>로 실제 파이프라인(Controller · 검증 · 예외 처리 · 요청 로그)을 띄운다(S03-T07).
    Microsoft.AspNetCore.Mvc.Testing이 Api의 .deps.json을 출력 폴더로 복사한다.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\Services\Employee\EmergencyHub.Employee.Api\EmergencyHub.Employee.Api.csproj" />
    <ProjectReference Include="..\..\..\..\src\Services\Employee\EmergencyHub.Employee.Infrastructure\EmergencyHub.Employee.Infrastructure.csproj" />
  </ItemGroup>

</Project>
