<Project Sdk="Microsoft.NET.Sdk">

  <!--
    OutputType=Exe · IsTestProject=true는 Directory.Build.props가 이름 규칙(*Tests)으로 지정한다(ADR-0021).
    xunit.runner.visualstudio · coverlet.collector · NSubstitute.Analyzers.CSharp의 PrivateAssets=all은 Directory.Build.targets가 적용한다.
    DB · 서버 없이 Controller(ISender 대역)와 Program 구성(등록 · 헬스 검사 · 요청 로그 수준 · Development 한정 Swagger)을 확인한다(S03-T04).
    Microsoft.AspNetCore.TestHost: 운영 등록(Program)으로 띄운 TestServer에서 일괄 등록 라우팅 · 필터 · 전용 바인더 · 예외 처리 · Swagger 문서를 ISender 대역으로 확인한다(S06-T05).
    HTTP 전 구간(Kestrel · 실제 DB)은 IntegrationTests(S06-T06) 범위다.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="NSubstitute.Analyzers.CSharp" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\Services\Employee\EmergencyHub.Employee.Api\EmergencyHub.Employee.Api.csproj" />
  </ItemGroup>

</Project>
