<?xml version="1.0" encoding="utf-8"?>
<!--
  커버리지 수집 설정(coverlet.collector, VSTest "XPlat Code Coverage").
  원본: wiki/03-architecture/adr/0022-respawn-and-coverage-tooling.md "커버리지",
  wiki/04-development/testing-strategy.md "커버리지 기준", PRD-001 NFR-03.

  사용: .github/workflows/ci.yml의 "Test (coverage)" 단계(dotnet test의 collect · settings 옵션).
  XML 주석 안에는 하이픈 두 개를 쓸 수 없어 명령 원문은 워크플로와 testing-strategy.md에 둔다.
  - Include: NFR-03 대상 어셈블리만. 아직 없는 어셈블리(BuildingBlocks.Application, Employee.*)는
    패턴으로 미리 넣어 두어 프로젝트가 생기면 설정 변경 없이 측정된다.
  - Api · Infrastructure는 커버리지 대신 통합 테스트로 확인한다(대상 아님).
  - 80%는 목표이며 임계값 실패(필수 체크)는 걸지 않는다(보고만).
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[EmergencyHub.BuildingBlocks.Domain]*,[EmergencyHub.BuildingBlocks.Application]*,[EmergencyHub.Employee.Domain]*,[EmergencyHub.Employee.Application]*</Include>
          <Exclude>[*.UnitTests]*,[*.IntegrationTests]*,[*.ArchitectureTests]*</Exclude>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <ExcludeByFile>**/Migrations/**,**/obj/**,**/*.g.cs,**/*.g.i.cs,**/*.Designer.cs,**/*.designer.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
