<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    Employee 마이그레이션 적용 워커(ADR-0012, database.md "마이그레이션 규칙 > 로컬 적용"). Write 연결로 실행 전략 안에서 MigrateAsync만 하고 종료한다.
    자기 서비스 Infrastructure와 ServiceDefaults만 참조한다(ADR-0024 의존성 규칙 표 <Service>.MigrationService 행). Api 계열은 참조하지 않는다.
    Logging.Abstractions는 [LoggerMessage] 소스 생성기 때문에 직접 참조한다(분석기 자산은 전이되지 않음).
    HTTP · /health 엔드포인트는 없다. 준비 판단은 AppHost WaitForCompletion(종료 코드)이 한다.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Aspire\EmergencyHub.ServiceDefaults\EmergencyHub.ServiceDefaults.csproj" />
    <ProjectReference Include="..\EmergencyHub.Employee.Infrastructure\EmergencyHub.Employee.Infrastructure.csproj" />
  </ItemGroup>

</Project>
